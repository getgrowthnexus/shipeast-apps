{
  "name": "shipeast-functions",
  "version": "1.0.0",
  "private": true,
  "description": "ShipEast Cloud Functions (P2-03). Server-side work the clients must not be trusted with.",
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "node --test lib/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "eslint": "^9.13.0"
  }
}
